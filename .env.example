DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional separate migration connection; Docker startup falls back to DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-secret
BREVO_API_KEY=replace-with-server-only-brevo-key
CLIENT_LINK=https://kadomoda.com/
PORT=3000
CORS_ORIGINS=https://kadomoda.com,https://www.kadomoda.com
# Optional exact proxy IP/CIDR allowlist. Do not set this to true or wildcard.
# TRUST_PROXY=172.18.0.2
# Optional one-time server-only bootstrap settings; remove after provisioning.
# BOOTSTRAP_ADMIN_EMAIL=solitdio079@gmail.com
# BOOTSTRAP_ADMIN_NAME=Djoko Keita
# BOOTSTRAP_ADMIN_PASSWORD=
