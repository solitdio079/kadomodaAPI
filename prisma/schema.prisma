// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Status {
  PRIVATE
  PUBLIC
}

enum OrderStatus {
  PROCESSING
  KARGODA
  TESLIM_EDILDI
  IPTAL
}

enum PaymentStatus{
  PAID 
  UNPAID
  REFUNDED
}


model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  posts Post[]
  verified Boolean @default(false)
  role Role @default(USER)
  comments Comment[]
  pwd String
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  cart Cart?
  addresses Address[]
  orders Order[]
} 

model Address {
  id Int @id @default(autoincrement())
  name String 
  zipcode String
  city String 
  country String @default("Türkiye")
  phone String
  address String
  owner User @relation(fields:[userId], references: [id])
  userId Int
  orders Order[]
}

model Product {
  id Int @id @default(autoincrement())
  name String
  details String @default("")
  sizes String[]
  total_qty Int
  price Decimal @db.Decimal(10,2)
  images String[] @default([])
  variant String
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignId Int?
  category Category @relation(fields:[categoryId], references: [id])
  categoryId Int
  isDemo Boolean @default(false)
  seedKey String? @unique
}

model Order {
  id Int @id @default(autoincrement())
  status OrderStatus @default(PROCESSING)
  orderProducts OrderProduct[]
  subtotal Decimal @db.Decimal(10,2)
  address Address @relation(fields:[addressId], references:[id])
  addressId Int
  owner User @relation(fields:[userId], references:[id])
  userId Int
  payment Payment?
}

model OrderProduct {
  id Int @id @default(autoincrement())
  productId Int
  name String
  size String 
  quantity Int 
  image String
  order Order @relation(fields:[orderId], references:[id])
  orderId Int 
}


model Payment{
  id Int @id @default(autoincrement())
  intent String?
  method String @default("Nakit")
  status PaymentStatus
  order Order @relation(fields:[orderId], references:[id])
  orderId Int @unique

}

model Cart {
  id Int @id @default(autoincrement())
  cartProducts CartProduct[]
  subtotal Decimal @db.Decimal(10,2) @default(0)
  user User @relation(fields:[userId], references:[id])
  userId Int @unique

}

model CartProduct {
  id Int @id @default(autoincrement())
  productId Int
  name String
  size String 
  quantity Int
  image String
  cart Cart @relation(fields:[cartId], references:[id])
  cartId Int 
  price Decimal @db.Decimal(10,2)
}

model Campaign {
  id Int @id @default(autoincrement())
  name String 
  image String?
  discount Int
  products Product[]
}

model Category {
  id Int @id @default(autoincrement())
  name String
  products Product[]
}





model Post { 
  id        Int     @id @default(autoincrement()) 
  title     String
  content   String?
  published Boolean @default(false) 
  author    User    @relation(fields: [authorId], references: [id]) 
  authorId  Int
  status Status @default(PRIVATE)
  comments Comment[]
  media String[] @default([])
  topics String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
} 

model Comment {
  id Int @id @default(autoincrement())
  content String 
  author User @relation(fields: [authorId], references: [id])
  parent Post @relation(fields: [postId], references: [id])
  authorId Int 
  postId Int
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}
